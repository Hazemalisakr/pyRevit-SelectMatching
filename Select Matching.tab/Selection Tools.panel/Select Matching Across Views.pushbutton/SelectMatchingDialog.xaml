<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sakr Tools - Select Matching"
        Width="520" Height="660"
        MinWidth="420" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Sakr Tools Branded Styles -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4C2335"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="ViewCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="16,3,0,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3B332E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <!-- Standard Button Style -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B332E"/>
            <Setter Property="BorderBrush" Value="#4C2335"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Branded Header -->
        <Border DockPanel.Dock="Top" Background="#4C2335" Padding="16,12">
            <StackPanel>
                <TextBlock Text="SELECT MATCHING"
                           Foreground="#F5F0E8" FontSize="15"
                           FontWeight="Bold" FontFamily="Segoe UI"/>
                <TextBlock Text="Sakr Tools"
                           Foreground="#E07856" FontSize="11"
                           FontFamily="Segoe UI" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="20,16,20,16">

            <!-- ===== Reference Element Info ===== -->
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#E07856"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="REFERENCE ELEMENT"
                               FontSize="11" FontWeight="Bold"
                               Foreground="#4C2335" FontFamily="Segoe UI"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="tb_category"
                               Foreground="#3B332E" FontFamily="Segoe UI" FontSize="13"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="tb_family"
                               Foreground="#3B332E" FontFamily="Segoe UI" FontSize="13"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="tb_type"
                               Foreground="#3B332E" FontFamily="Segoe UI" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ===== Search ===== -->
            <TextBlock DockPanel.Dock="Top"
                       Text="SEARCH VIEWS"
                       FontSize="11" FontWeight="Bold"
                       Foreground="#4C2335" FontFamily="Segoe UI"
                       Margin="0,0,0,6"/>

            <TextBox DockPanel.Dock="Top"
                     x:Name="txt_search"
                     Margin="0,0,0,12"
                     Padding="6,4"
                     FontFamily="Segoe UI" FontSize="13"
                     BorderBrush="#4C2335"
                     ToolTip="Type to filter views by name"/>

            <!-- ===== Bottom Action Buttons ===== -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tb_status"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#E07856"
                           FontFamily="Segoe UI"
                           FontSize="12"/>

                <Button x:Name="btn_cancel"
                        Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource StandardButton}"
                        Margin="0,0,8,0"
                        Width="80"/>

                <Button x:Name="btn_select"
                        Grid.Column="2"
                        Content="Select"
                        Background="#4C2335" Foreground="#F5F0E8"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Cursor="Hand"
                        Width="80"
                        Padding="4,5">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ===== Select All / Clear All ===== -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Margin="0,12,0,0">
                <Button x:Name="btn_select_all"
                        Content="Select All"
                        Style="{StaticResource StandardButton}"
                        Padding="12,4"
                        Margin="0,0,8,0"/>
                <Button x:Name="btn_clear_all"
                        Content="Clear All"
                        Style="{StaticResource StandardButton}"
                        Padding="12,4"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="tb_count"
                           VerticalAlignment="Center"
                           Foreground="#3B332E" FontFamily="Segoe UI"
                           Margin="8,0,0,0"
                           FontSize="12"/>
            </StackPanel>

            <!-- ===== View List ===== -->
            <Border BorderBrush="#4C2335"
                    BorderThickness="1"
                    Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="sp_views"
                                Margin="10,6,10,10"/>
                </ScrollViewer>
            </Border>

        </DockPanel>
    </DockPanel>
</Window>
